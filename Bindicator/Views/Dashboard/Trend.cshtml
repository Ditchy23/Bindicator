@model Bindicator.ViewModels.BinTrendViewModel

@{
    ViewData["Title"] = "Bin Fill Trend";

    var labels = Model.Readings.Select(r => r.Timestamp.ToLocalTime().ToString("dd MMM HH:mm")).ToList();
    var fillLevels = Model.Readings.Select(r => r.FillLevel).ToList();
    var weights = Model.Readings.Select(r => r.Weight).ToList();
    var densities = Model.Readings.Select(r => r.Density).ToList();
    var temperatures = Model.EnvironmentReadings.Select(e => e.Temperature).ToList();
    var humidities = Model.EnvironmentReadings.Select(e => e.Humidity).ToList();
}

<h2>Bin Fill Trend</h2>

<p>
    <strong>@Model.Street @Model.BinNumber</strong> (@Model.Postcode)
</p>

<a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary mb-3">
    <i class="fas fa-arrow-left"></i> Back to Dashboard
</a>

<canvas id="fillChart" width="800" height="400"></canvas>

@if (Model.PredictedFullDate.HasValue && Model.DaysToFull.HasValue)
{
    <div class="alert alert-info mt-4">
        <strong>🧠 Prediction:</strong><br />
        Based on current trends, this bin is predicted to be full
        <strong>@Model.DaysToFull.Value.ToString("0.0") days</strong> from the earliest reading,
        around <strong>@Model.PredictedFullDate.Value.ToLocalTime().ToString("f")</strong>.
    </div>
}
else
{
    <div class="alert alert-secondary mt-4">
        Prediction not available — not enough historical data.
    </div>
}

@section Scripts{
<!-- Chart.js & Annotations plugin -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-annotation@3.0.1"></script>

<script>
    // Register the Chart.js annotation plugin
    Chart.register(window['chartjs-plugin-annotation']);

    // Get the 2D rendering context of the canvas element
    const ctx = document.getElementById('fillChart').getContext('2d');

    // Create a new Chart.js line chart
    const chart = new Chart(ctx, {
        type: 'line', // Specify the chart type as a line chart
        data: {
            labels: @Html.Raw(Json.Serialize(labels)), // X-axis labels (timestamps of readings)
            datasets: [
                {
                    label: 'Fill Level (%)', // Dataset label for fill levels
                    data: @Html.Raw(Json.Serialize(fillLevels)), // Y-axis data for fill levels
                    borderColor: 'blue', // Line color
                    backgroundColor: 'rgba(0, 0, 255, 0.1)', // Fill color under the line
                    tension: 0.2, // Line tension for smooth curves
                    fill: false // Disable area fill under the line
                },
                {
                    label: 'Weight (kg)', // Dataset label for weights
                    data: @Html.Raw(Json.Serialize(weights)), // Y-axis data for weights
                    borderColor: 'red', // Line color
                    backgroundColor: 'rgba(255, 0, 0, 0.1)', // Fill color under the line
                    tension: 0.2, // Line tension for smooth curves
                    fill: false // Disable area fill under the line
                },
                {
                    label: 'Density', // Dataset label for density
                    data: @Html.Raw(Json.Serialize(densities)), // Y-axis data for density
                    borderColor: 'green', // Line color
                    backgroundColor: 'rgba(0, 128, 0, 0.1)', // Fill color under the line
                    tension: 0.2, // Line tension for smooth curves
                    fill: false // Disable area fill under the line
                },
                {
                    label: 'Temperature (°C)', // Dataset label for temperature
                    data: @Html.Raw(Json.Serialize(temperatures)), // Y-axis data for temperature
                    borderColor: 'orange', // Line color
                    backgroundColor: 'rgba(255, 165, 0, 0.1)', // Fill color under the line
                    tension: 0.2, // Line tension for smooth curves
                    fill: false // Disable area fill under the line
                },
                {
                    label: 'Humidity (%)', // Dataset label for humidity
                    data: @Html.Raw(Json.Serialize(humidities)), // Y-axis data for humidity
                    borderColor: 'purple', // Line color
                    backgroundColor: 'rgba(128, 0, 128, 0.1)', // Fill color under the line
                    tension: 0.2, // Line tension for smooth curves
                    fill: false // Disable area fill under the line
                }
            ]
        },
        options: {
            responsive: true, // Make the chart responsive to screen size
            plugins: {
                legend: {
                    position: 'top' // Position the legend at the top of the chart
                },
                title: {
                    display: false // Disable the chart title
                },
                annotation: {
                    annotations: {} // Add spike annotations to the chart, currently disapled
                }
            },
            scales: {
                x: {
                    title: {
                        display: true,
                        text: 'Time'
                    }
                    // No type, Chart.js will treat this as category axis
                },
                y: {
                    beginAtZero: true,
                    title: {
                        display: true,
                        text: 'Fill Level (%)'
                    }
                }
            }
        }
    });

     // Set up the SignalR connection
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/binStatusHub")
            .build();

        // Listen for trend update messages for this bin
        connection.on("ReceiveTrendUpdate", function (postcode, street, binNumber) {
            // These should match the current view's bin
            const thisPostcode = "@Model.Postcode".toUpperCase();
            const thisStreet = "@Model.Street".toUpperCase();
            const thisBinNumber = "@Model.BinNumber";

            // If the update matches this view, reload the page (or partial, for advanced!)
            if (
                postcode.toUpperCase() === thisPostcode &&
                street.toUpperCase() === thisStreet &&
                binNumber == thisBinNumber
            ) {
                location.reload();
            }
        });

        connection.start().catch(function (err) {
            return console.error(err.toString());
        });
</script>
}