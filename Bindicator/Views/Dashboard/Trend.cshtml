@model Bindicator.ViewModels.BinTrendViewModel

@{
    ViewData["Title"] = "B-inspirations";

    var sensorLabels = Model.Readings.Select(r => r.Timestamp.ToLocalTime().ToString("dd MMM HH:mm")).ToList();
    var environmentLabels = Model.EnvironmentReadings.Select(e => e.Timestamp.ToLocalTime().ToString("dd MMM HH:mm")).ToList();

    var fillLevels = Model.Readings.Select(r => r.FillLevel).ToList();
    var weights = Model.Readings.Select(r => r.Weight).ToList();
    var densities = Model.Readings.Select(r => r.Density).ToList();
    var temperatures = Model.EnvironmentReadings.Select(e => e.Temperature).ToList();
    var humidities = Model.EnvironmentReadings.Select(e => e.Humidity).ToList();

    var recentCutoff = DateTime.UtcNow.AddHours(-24);
    var recentWarnings = Model.WarningHistory.Where(w => w.Timestamp > recentCutoff).OrderByDescending(w => w.Timestamp).ToList();
    var historicalWarnings = Model.WarningHistory.Where(w => w.Timestamp <= recentCutoff).OrderByDescending(w => w.Timestamp).ToList();

}

<h2>B-inspirations</h2>

<p>
    <strong>@Model.Street @Model.BinNumber</strong> (@Model.Postcode)
</p>

<a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary mb-3">
    <i class="fas fa-arrow-left"></i> Back to Dashboard
</a>

<div id="updateStatus" class="text-info mb-3" style="display: none;">
    <i class="fas fa-sync fa-spin"></i> Updating data...
</div>


<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm">
            <div class="card-header fw-bold">Fill Level (%)</div>
            <div class="card-body">
                <canvas id="fillChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm">
            <div class="card-header fw-bold">Weight (kg)</div>
            <div class="card-body">
                <canvas id="weightChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm">
            <div class="card-header fw-bold">Density</div>
            <div class="card-body">
                <canvas id="densityChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm">
            <div class="card-header fw-bold">Temperature (°C)</div>
            <div class="card-body">
                <canvas id="temperatureChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm">
            <div class="card-header fw-bold">Humidity (%)</div>
            <div class="card-body">
                <canvas id="humidityChart"></canvas>
            </div>
        </div>
    </div>
</div>


@if (Model.PredictedFullDate.HasValue && Model.DaysToFull.HasValue)
{
    <div class="alert alert-info mt-4">
        <strong>🧠 Prediction:</strong><br />
        Based on current trends, this bin is predicted to be full
        <strong>@Model.DaysToFull.Value.ToString("0.0") days</strong> from the earliest reading,
        around <strong>@Model.PredictedFullDate.Value.ToLocalTime().ToString("f")</strong>.
    </div>
}
else
{
    <div class="alert alert-secondary mt-4">
        Prediction not available — not enough historical data.
    </div>
}

@if (recentWarnings.Any())
{
    <div class="card mt-4 shadow-sm">
        <div class="card-header bg-warning-subtle text-dark">
            <strong>⚠️ New Warnings (Last 24h)</strong>
        </div>
        <div class="card-body p-0">
            <ul class="list-group list-group-flush">
                @foreach (var warning in recentWarnings)
                {
                    <li class="list-group-item d-flex align-items-center" style="background: inherit;">
                        <div class="flex-fill">
                            <span class="me-2">@warning.Message</span>
                        </div>
                        <div class="text-muted small text-end" style="min-width: 140px;">
                            @warning.Timestamp.ToLocalTime().ToString("g")
                        </div>
                        <span class="badge bg-warning text-dark ms-2">New</span>
                    </li>
                }
            </ul>
        </div>
    </div>
}

@if (historicalWarnings.Any())
{
    <div class="accordion mt-3" id="historicalWarningsAccordion">
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingHistory">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHistory" aria-expanded="false" aria-controls="collapseHistory">
                    Historical Warnings (older than 24h)
                </button>
            </h2>
            <div id="collapseHistory" class="accordion-collapse collapse" aria-labelledby="headingHistory" data-bs-parent="#historicalWarningsAccordion">
                <div class="accordion-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var warning in historicalWarnings)
                        {
                            <li class="list-group-item d-flex align-items-center" style="background: inherit;">
                                <div class="flex-fill">
                                    <span class="me-2">@warning.Message</span>
                                </div>
                                <div class="text-muted small text-end" style="min-width: 140px;">
                                    @warning.Timestamp.ToLocalTime().ToString("g")
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
}


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-annotation@3.0.1"></script>

    <script>
        Chart.register(window['chartjs-plugin-annotation']);

        const sensorLabels = @Html.Raw(Json.Serialize(sensorLabels));
        const environmentLabels = @Html.Raw(Json.Serialize(environmentLabels));

        const chartConfigs = [
            { id: "fillChart", labels: sensorLabels, data: @Html.Raw(Json.Serialize(fillLevels)), label: "Fill Level (%)", color: "blue" },
            { id: "weightChart", labels: sensorLabels, data: @Html.Raw(Json.Serialize(weights)), label: "Weight (kg)", color: "red" },
            { id: "densityChart", labels: sensorLabels, data: @Html.Raw(Json.Serialize(densities)), label: "Density", color: "green" },
            { id: "temperatureChart", labels: environmentLabels, data: @Html.Raw(Json.Serialize(temperatures)), label: "Temperature (°C)", color: "orange" },
            { id: "humidityChart", labels: environmentLabels, data: @Html.Raw(Json.Serialize(humidities)), label: "Humidity (%)", color: "purple" }
        ];

        const charts = [];

        chartConfigs.forEach(cfg => {
            const ctx = document.getElementById(cfg.id)?.getContext('2d');
            if (!ctx) return;
            const chart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: cfg.labels,
                    datasets: [{
                        label: cfg.label,
                        data: cfg.data,
                        borderColor: cfg.color,
                        backgroundColor: 'rgba(0,0,0,0.07)',
                        tension: 0.2,
                        fill: false
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { title: { display: true, text: 'Time' } },
                        y: { beginAtZero: true, title: { display: true, text: cfg.label } }
                    }
                }
            });
            charts.push(chart);
        });

        // SignalR connection handling (no change needed here)
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/binStatusHub")
            .build();

        connection.on("ReceiveTrendUpdate", function (postcode, street, binNumber) {
            const thisPostcode = "@Model.Postcode".toUpperCase();
            const thisStreet = "@Model.Street".toUpperCase();
            const thisBinNumber = "@Model.BinNumber";

            if (postcode.toUpperCase() === thisPostcode &&
                street.toUpperCase() === thisStreet &&
                binNumber == thisBinNumber) {

                const updateStatus = document.getElementById('updateStatus');
                updateStatus.style.display = 'block';
                updateStatus.style.opacity = '1';
                updateStatus.style.transition = 'none';

                fetch(`/Dashboard/GetLatestTrendData?postcode=${postcode}&street=${street}&binNumber=${binNumber}`)
                    .then(response => response.json())
                    .then(data => {
                        updateCharts(data);
                    })
                    .catch(error => console.error('Error fetching trend data:', error))
                    .finally(() => {
                        setTimeout(() => {
                            updateStatus.style.transition = 'opacity 0.5s ease-out';
                            updateStatus.style.opacity = '0';
                            setTimeout(() => {
                                updateStatus.style.display = 'none';
                            }, 500);
                        }, 500);
                    });
            }
        });

        connection.start().catch(function (err) {
            return console.error(err.toString());
        });

        function updateCharts(data) {
            charts.forEach((chart, idx) => {
                chart.data.datasets[0].data = data.datasets[idx].data;
                chart.data.labels = data.datasets[idx].labels;
                chart.update();
            });
        }
    </script>
}
