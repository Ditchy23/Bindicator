@model List<Bindicator.ViewModels.BinStatusViewModel>

@{
    ViewData["Title"] = "Bin dashboard";
}

<div class="mb-3">
    <a asp-controller="Dashboard" asp-action="Map" class="btn btn-outline-primary">
        🗺️ View Map
    </a>
</div>

<style>
    th {
        cursor: pointer;
    }
</style>

<h2>Bin dashboard</h2>
<p class="lead">The dashboard shows data for all bins.</p>
<p class="lead">Live sensor data is displayed real-time.</p>
<ul>
    <li>Search table by street or postcode.</li>
    <li>Sort table by column headers.</li>
    <li>Colours visually represent bin fullness.</li>
    <li>Use bin view trend link to see real-time/recorded sensor data and warnings.</li>
</ul>

<input type="text" id="binFilter" class="form-control mb-3" placeholder="Search by street or postcode" />

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Postcode</th>
            <th>Street</th>
            <th>Bin #</th>
            <th>Fill Level (%)</th>
            <th>Weight (kg)</th>
            <th>Density</th>
            <th>Temp</th>
            <th>Humidity</th>
            <th>Last Updated</th>
            <th>Trend</th>
        </tr>
    </thead>
    <tbody id="binTableBody">
        @await Html.PartialAsync("_BinTable", Model)
    </tbody>
</table>


@section Scripts {
    <script>
        let isFiltering = false;

        // Function to sort the table by column
        function applyFilter() {
            const filter = document.getElementById('binFilter').value.toLowerCase();
            document.querySelectorAll("#binTableBody tr").forEach(function (row) {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(filter) ? '' : 'none';
            });
        }

        // Event listeners for the filter input
        document.getElementById('binFilter').addEventListener('focus', () => isFiltering = true);
        document.getElementById('binFilter').addEventListener('blur', () => isFiltering = false);
        document.getElementById('binFilter').addEventListener('keyup', applyFilter);

        // Connect to the SignalR hub
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/binStatusHub")
            .build();

        connection.on("ReceiveBinUpdate", function () {
            // Reload the bin table when a message is received
            fetch('/Dashboard/GetLatestBins')
                .then(res => res.text())
                .then(html => {
                    document.getElementById('binTableBody').innerHTML = html;
                    // Optionally, re-apply filtering if you have it
                    if (typeof applyFilter === "function") applyFilter();
                });
        });

        connection.start().catch(function (err) {
            return console.error(err.toString());
        });
    </script>
}