@{
    ViewData["Title"] = "Dashboard - No Data";
}

<div class="alert alert-warning mt-4 text-center">
    <h4>🚫 No data available</h4>
    <p>@ViewBag.ErrorMessage</p>
    <p>This application is a prototype.</p>
    <p>As such you can seed test data that demostrates the application features, using the button on this page.</p>
    <p>Seeding data will create a database with semi-random data that demostrates seonsor data trends, warnings, alerts and route mapping.</p>
    <p>Once the database is created the application will recieve and process live sensor data sent from the appropriate MQTT channels.</p>
    <p>Live sensor data is displayed in real-time using SignalR</p>
</div>
<form asp-action="SeedData" asp-controller="Dashboard" method="post" class="mb-3">
    <button type="submit" class="btn btn-warning">
        🔄 Seed Dummy Data
    </button>
</form>