@model List<Bindicator.ViewModels.SensorDataViewModel>

@{
    ViewData["Title"] = "Bin locations";
}

<h2>Bin locations and collection routes</h2>
<p class="lead">The map displays the location of bins that are full or have a predicted full-date.</p>
<p class="lead">Bins in the priority collection are either full now, or will be full within 24hrs</p>
<p class="lead">Remaining bins with a predicted full-date are displayed in the non-priority collection</p>
<p class="lead">Map markers display more details about each bin.</p>
<p>Only bins ready to be included in a collection are displayed.</p>
<p>To see the location of all bins use the toggle under the map. These bins are not routed.</p>

<!-- First Collection Information -->
<div class="card mb-3">
    <div class="card-header">
        <h3>Priority collection info</h3>
    </div>
    <div class="card-body">
        <p><strong>Priority collection date:</strong> @ViewBag.FirstCollectionDate.ToString("f")</p>
        <p><strong>Total weight for priority collection:</strong> @String.Format("{0:N2} kg", ViewBag.TotalWeightFirstCollection)</p>
        <p><strong>Wagons needed:</strong> @ViewBag.WagonsForFirstCollection</p>

        <!-- Calculate Route Button for First Collection -->
        <div class="mb-2">
            <button id="routeBtn" class="btn btn-primary ms-2">Calculate route</button>
        </div>

        <!-- Toggle checkbox for First Collection Route -->
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="toggleRouteFirst" disabled />
            <label class="form-check-label" for="toggleRouteFirst">
                Toggle route display on map
            </label>
        </div>
    </div>
</div>

<!-- Accordion for Bins in First Collection -->
<div class="accordion" id="accordionFirstCollection">
    <div class="accordion-item">
        <h4 class="accordion-header" id="headingFirstCollection">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFirstCollection" aria-expanded="false" aria-controls="collapseFirstCollection">
                Bins for priority collection
            </button>
        </h4>
        <div id="collapseFirstCollection" class="accordion-collapse collapse" aria-labelledby="headingFirstCollection" data-bs-parent="#accordionFirstCollection">
            <div class="accordion-body">
                <ul class="list-group">
                    @foreach (var bin in ViewBag.BinsForFirstCollection)
                    {
                        <li class="list-group-item">
                            <div class="d-flex w-100 justify-content-between">
                                <p class="mb-1">
                                    <strong>Street:</strong> @bin.Street<br />
                                    <strong>Postcode:</strong> @bin.Postcode<br />
                                    <strong>Bin #</strong>@bin.BinNumber
                                </p>
                                <small>
                                    @bin.FillLevel.ToString("F2")% full,
                                    @bin.Weight.ToString("F2") kg
                                </small>
                            </div>
                            <p class="mb-1">
                                <strong>Predicted Collection Date:</strong>
                                @if (bin.PredictedFullDate != null)
                                {
                                    @bin.PredictedFullDate?.ToString("f")
                                }
                                else
                                {
                                    @:N/A, bin is full or almost full
                                }
                            </p>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<hr class="my-4">

<!-- Second Collection Information -->
<div class="card mb-3">
    <div class="card-header">
        <h3>Non-priority collection info</h3>
    </div>
    <div class="card-body">
        <p><strong>Non-priority collection date:</strong> @ViewBag.SecondCollectionDate.ToString("f")</p>
        <p><strong>Total weight for non-priority collection:</strong> @String.Format("{0:N2} kg", ViewBag.TotalWeightSecondCollection)</p>
        <p><strong>Wagons needed:</strong> @ViewBag.WagonsForSecondCollection</p>

        <!-- Calculate Route Button for Second Collection -->
        <div class="mb-2">
            <button id="routeBtn2" class="btn btn-primary ms-2">Calculate route</button>
        </div>

        <!-- Toggle checkbox for Second Collection Route -->
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="toggleRouteSecond" disabled />
            <label class="form-check-label" for="toggleRouteSecond">
                Toggle route display on map
            </label>
        </div>
    </div>
</div>

<!-- Accordion for Bins in Second Collection -->
<div class="accordion" id="accordionSecondCollection">
    <div class="accordion-item">
        <h4 class="accordion-header" id="headingSecondCollection">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSecondCollection" aria-expanded="false" aria-controls="collapseSecondCollection">
                Bins for non-priority collection
            </button>
        </h4>
        <div id="collapseSecondCollection" class="accordion-collapse collapse" aria-labelledby="headingSecondCollection" data-bs-parent="#accordionSecondCollection">
            <div class="accordion-body">
                <ul class="list-group">
                    @foreach (var bin in ViewBag.BinsForSecondCollection)
                    {
                        <li class="list-group-item">
                            <div class="d-flex w-100 justify-content-between">
                                <p class="mb-1">
                                    <strong>Street:</strong> @bin.Street<br />
                                    <strong>Postcode:</strong> @bin.Postcode<br />
                                    <strong>Bin #</strong>@bin.BinNumber
                                </p>
                                <small>
                                    @bin.FillLevel.ToString("F2")% full,
                                    @bin.Weight.ToString("F2") kg
                                </small>
                            </div>
                            <p class="mb-1">
                                <strong>Predicted Collection Date:</strong>
                                @if (bin.PredictedFullDate != null)
                                {
                                    @bin.PredictedFullDate?.ToString("f")
                                }
                                else
                                {
                                    @:N/A, bin is full or almost full
                                }
                            </p>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<hr class="my-4">

<!--Map Area -->
<div id="map" style="height: 500px; width: 100%;"></div>

<!-- Toggle for Displaying all bins -->
<div class="form-check my-3">
    <input class="form-check-input" type="checkbox" id="toggleAllBins" />
    <label class="form-check-label" for="toggleAllBins">
        Show All Bins
    </label>
</div>

<script src="https://atlas.microsoft.com/sdk/javascript/mapcontrol/2/atlas.min.js"></script>
<link href="https://atlas.microsoft.com/sdk/javascript/mapcontrol/2/atlas.min.css" rel="stylesheet" />
<script>
    const subscriptionKey = '6YZVxWqgi0evzdHfzLVwAVke8lgbHuNwhaMQKSv5TiDbpSZD1SCQJQQJ99BDAC5RqLJvjAgdAAAgAZMP1fVL';

    const map = new atlas.Map('map', {
        center: [-1.3, 54.56],
        zoom: 13,
        style: 'night',
        authOptions: {
            authType: 'subscriptionKey',
            subscriptionKey: subscriptionKey
        }
    });

    function getFillColor(fillLevel) {
        const clamp = (val, min, max) => Math.max(min, Math.min(val, max));
        const t = clamp(fillLevel / 100, 0, 1);
        const r = 255;
        const g = Math.round(255 * (1 - t));
        const b = Math.round(255 * (1 - t));
        return `rgb(${r}, ${g}, ${b})`;
    }

    let routeLineSourceFirst = null;
    let routeLineLayerFirst = null;
    let routeLineSourceSecond = null;
    let routeLineLayerSecond = null;

    map.events.add('ready', () => {
        const binsFirstCollection = @Html.Raw(Json.Serialize(ViewBag.BinsForFirstCollection));
        const binsSecondCollection = @Html.Raw(Json.Serialize(ViewBag.BinsForSecondCollection));
        const allBins = @Html.Raw(Json.Serialize(ViewBag.AllBins));

        let bounds = null;

        // Adding markers for bins
        function addMarkers(bins) {
            bins.forEach(bin => {
                // Skip bins with invalid latitude and longitude (0,0)
                if (bin.latitude !== 0 && bin.longitude !== 0) {
                    const fillColor = getFillColor(bin.fillLevel);

                    const marker = new atlas.HtmlMarker({
                        position: [bin.longitude, bin.latitude],
                        text: `${bin.binNumber}`,
                        color: fillColor
                    });

                    // Expand map bounds
                    if (!bounds) {
                        bounds = [[bin.longitude, bin.latitude], [bin.longitude, bin.latitude]];
                    } else {
                        bounds[0][0] = Math.min(bounds[0][0], bin.longitude);
                        bounds[0][1] = Math.min(bounds[0][1], bin.latitude);
                        bounds[1][0] = Math.max(bounds[1][0], bin.longitude);
                        bounds[1][1] = Math.max(bounds[1][1], bin.latitude);
                    }

                    // Create a popup for the marker
                    const popupContent = document.createElement('div');
                    popupContent.innerHTML = `
                        <strong>Bin #${bin.binNumber}</strong><br/>
                        <strong>Fill Level:</strong> ${bin.fillLevel.toFixed(2)}%<br/>
                        <strong>Weight:</strong> ${bin.weight.toFixed(2)} kg<br/>
                        <strong>Predicted Full Date:</strong> ${bin.predictedFullDate ? new Date(bin.predictedFullDate).toLocaleString() : 'N/A'}`;

                    const popup = new atlas.Popup({ position: [bin.longitude, bin.latitude] });
                    popup.setOptions({ content: popupContent });

                    map.markers.add(marker);
                    map.events.add('click', marker, () => popup.open(map));
                }
            });

            // Log the bounds and camera settings
            if (bounds && bins.length > 1) {
                map.setCamera({
                    bounds: atlas.data.BoundingBox.fromPositions([bounds[0], bounds[1]]),
                    padding: 60
                });
            }
        }

        // Add markers for first and second collection bins
        addMarkers(binsFirstCollection);
        addMarkers(binsSecondCollection);

        // Toggle for showing all bins
        document.getElementById('toggleAllBins').addEventListener('change', function() {
            if (this.checked) {
                // Show all bins
                addMarkers(allBins);
            } else {
                // Clear all markers and show only collection bins
                map.markers.clear();
                addMarkers(binsFirstCollection);
                addMarkers(binsSecondCollection);
            }
        });

        // First Collection: Route calculation
        document.getElementById("routeBtn").onclick = async function() {
            // Only add the route once
            if (!routeLineLayerFirst) {
                const firstCollectionWaypoints = binsFirstCollection.map(bin => `${bin.latitude},${bin.longitude}`).filter(waypoint => waypoint !== "0,0"); // Exclude invalid waypoints (0,0);
                if (firstCollectionWaypoints.length < 2) {
                    alert("Not enough valid bins in the first collection for routing.");
                    return;
                }

                const routeUrlFirst = `https://atlas.microsoft.com/route/directions/json?api-version=1.0&subscription-key=${subscriptionKey}&query=${firstCollectionWaypoints.join(':')}`;
                console.log("Generated Route URL:", routeUrlFirst);  // Log the full URL
                const responseFirst = await fetch(routeUrlFirst);
                const dataFirst = await responseFirst.json();

                if (!dataFirst.routes || dataFirst.routes.length === 0) {
                    alert("No route found for the first collection.");
                    return;
                }

                const routePointsFirst = dataFirst.routes[0].legs.flatMap(leg => leg.points.map(pt => [pt.longitude, pt.latitude]));

                routeLineSourceFirst = new atlas.source.DataSource();
                map.sources.add(routeLineSourceFirst);

                const routeLineFirst = new atlas.data.LineString(routePointsFirst);
                routeLineSourceFirst.add(new atlas.data.Feature(routeLineFirst));

                routeLineLayerFirst = new atlas.layer.LineLayer(routeLineSourceFirst, null, { strokeColor: '#00BFFF', strokeWidth: 5 });
                map.layers.add(routeLineLayerFirst);

                // Enable the toggle checkbox once the route is added
                document.getElementById("toggleRouteFirst").disabled = false; // Enable toggle for the first collection route
            }
        };

        // Second Collection: Route calculation
        document.getElementById("routeBtn2").onclick = async function() {
            // Only add the route once
            if (!routeLineLayerSecond) {
                const secondCollectionWaypoints = binsSecondCollection.map(bin => `${bin.latitude},${bin.longitude}`).filter(waypoint => waypoint !== "0,0"); // Exclude invalid waypoints (0,0);
                if (secondCollectionWaypoints.length < 2) {
                    alert("Not enough valid bins in the second collection for routing.");
                    return;
                }

                const routeUrlSecond = `https://atlas.microsoft.com/route/directions/json?api-version=1.0&subscription-key=${subscriptionKey}&query=${secondCollectionWaypoints.join(':')}`;
                console.log("Generated Route URL:", routeUrlSecond);  // Log the full URL
                const responseSecond = await fetch(routeUrlSecond);
                const dataSecond = await responseSecond.json();

                if (!dataSecond.routes || dataSecond.routes.length === 0) {
                    alert("No route found for the second collection.");
                    return;
                }

                const routePointsSecond = dataSecond.routes[0].legs.flatMap(leg => leg.points.map(pt => [pt.longitude, pt.latitude]));

                routeLineSourceSecond = new atlas.source.DataSource();
                map.sources.add(routeLineSourceSecond);

                const routeLineSecond = new atlas.data.LineString(routePointsSecond);
                routeLineSourceSecond.add(new atlas.data.Feature(routeLineSecond));

                routeLineLayerSecond = new atlas.layer.LineLayer(routeLineSourceSecond, null, { strokeColor: '#00FF00', strokeWidth: 5 });
                map.layers.add(routeLineLayerSecond);

                // Enable the toggle checkbox once the route is added
                document.getElementById("toggleRouteSecond").disabled = false; // Enable toggle for the second collection route
            }
        };

        // Add event listeners for toggling route visibility
        document.getElementById("toggleRouteFirst").addEventListener("change", function() {
            if (this.checked) {
                if (routeLineLayerFirst) {
                    routeLineLayerFirst.setOptions({ visible: true }); // Set layer to visible
                }
            } else {
                if (routeLineLayerFirst) {
                    routeLineLayerFirst.setOptions({ visible: false }); // Hide layer
                }
            }
        });

        document.getElementById("toggleRouteSecond").addEventListener("change", function() {
            if (this.checked) {
                if (routeLineLayerSecond) {
                    routeLineLayerSecond.setOptions({ visible: true }); // Set layer to visible
                }
            } else {
                if (routeLineLayerSecond) {
                    routeLineLayerSecond.setOptions({ visible: false }); // Hide layer
                }
            }
        });
    });
</script>