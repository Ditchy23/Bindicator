@model List<Bindicator.ViewModels.SensorDataViewModel>


@{
    ViewData["Title"] = "Bin Locations";
}

<h2>Bin Locations</h2>

<div class="mb-2">
    <button id="routeBtn" class="btn btn-primary ms-2">Show Route for All Bins</button>
</div>

<div id="map" style="height: 500px; width: 100%;"></div>

<script src="https://atlas.microsoft.com/sdk/javascript/mapcontrol/2/atlas.min.js"></script>
<link href="https://atlas.microsoft.com/sdk/javascript/mapcontrol/2/atlas.min.css" rel="stylesheet" />

<script>
    const subscriptionKey = '6YZVxWqgi0evzdHfzLVwAVke8lgbHuNwhaMQKSv5TiDbpSZD1SCQJQQJ99BDAC5RqLJvjAgdAAAgAZMP1fVL';

    const map = new atlas.Map('map', {
        center: [-1.3, 54.56],
        zoom: 13,
        style: 'night',
        authOptions: {
            authType: 'subscriptionKey',
            subscriptionKey: subscriptionKey
        }
    });

    function getFillColor(fillLevel) {
        const clamp = (val, min, max) => Math.max(min, Math.min(val, max));
        const t = clamp(fillLevel / 100, 0, 1);
        const r = 255;
        const g = Math.round(255 * (1 - t));
        const b = Math.round(255 * (1 - t));
        return `rgb(${r}, ${g}, ${b})`;
    }

    let routeLineSource = null;
    let routeLineLayer = null;

    map.events.add('ready', () => {
        const bins = @Html.Raw(Json.Serialize(Model)); // Now this is a list of SensorDataViewModel
        let bounds = null;
        const markerObjs = [];

        // Log the entire bins object for debugging
        console.log('Bins:', bins);

        bins.forEach(bin => {
            // Log individual bin data for debugging
            console.log(`Bin ${bin.binNumber}: Latitude = ${bin.latitude}, Longitude = ${bin.longitude}, FillLevel = ${bin.fillLevel}, Weight = ${bin.weight}, PredictedFullDate = ${bin.predictedFullDate}`);

            if (bin.latitude === 0 && bin.longitude === 0) {
                console.warn(`Skipping bin ${bin.binNumber}: Invalid coordinates (0, 0)`);
                return;
            }

            // Validate that fillLevel and other properties are numbers
            if (isNaN(bin.fillLevel) || isNaN(bin.weight) || isNaN(bin.latitude) || isNaN(bin.longitude)) {
                console.error(`Bin ${bin.binNumber} has invalid data: FillLevel = ${bin.fillLevel}, Weight = ${bin.weight}, Latitude = ${bin.latitude}, Longitude = ${bin.longitude}`);
                return;
            }

            const fillColor = getFillColor(bin.fillLevel);

            const marker = new atlas.HtmlMarker({
                position: [bin.longitude, bin.latitude],
                text: `${bin.binNumber}`,
                color: fillColor
            });

            // Expand map bounds
            if (!bounds) {
                bounds = [[bin.longitude, bin.latitude], [bin.longitude, bin.latitude]];
            } else {
                bounds[0][0] = Math.min(bounds[0][0], bin.longitude);
                bounds[0][1] = Math.min(bounds[0][1], bin.latitude);
                bounds[1][0] = Math.max(bounds[1][0], bin.longitude);
                bounds[1][1] = Math.max(bounds[1][1], bin.latitude);
            }

            const popupContent = document.createElement('div');
            popupContent.style.padding = '6px';
            popupContent.style.fontSize = '0.9em';
            popupContent.style.maxWidth = '220px';
            popupContent.innerHTML = `
                <strong>${bin.street} (Bin #${bin.binNumber})</strong><br/>
                <strong>Postcode:</strong> ${bin.postcode}<br/>
                <strong>Fill Level:</strong> ${bin.fillLevel.toFixed(0)}%<br/>
                <strong>Weight:</strong> ${bin.weight.toFixed(1)} kg<br/>
                <strong>Density:</strong> ${bin.density ? bin.density.toFixed(2) : 'N/A'}<br/>
                <strong>Updated:</strong> ${new Date(bin.timestamp).toLocaleString()}<br/>
                <strong>Predicted Full Date:</strong> ${bin.predictedFullDate ? new Date(bin.predictedFullDate).toLocaleString() : 'N/A'}<br/>
                <a style='color: #99ccff' href='/Dashboard/Trend?postcode=${encodeURIComponent(bin.postcode)}&street=${encodeURIComponent(bin.street)}&binNumber=${bin.binNumber}'>
                    View Trend
                </a>
            `;
            const popup = new atlas.Popup({ position: [bin.longitude, bin.latitude] });
            popup.setOptions({ content: popupContent });

            map.markers.add(marker);
            map.events.add('click', marker, () => popup.open(map));
            markerObjs.push({ marker, bin });
        });

        // Log the bounds and camera settings
        if (bounds && bins.length > 1) {
            console.log('Map bounds:', bounds);
            map.setCamera({
                bounds: atlas.data.BoundingBox.fromPositions([bounds[0], bounds[1]]),
                padding: 60
            });
        }

        document.getElementById("routeBtn").onclick = async function() {
            try {
                if (routeLineLayer) map.layers.remove(routeLineLayer);
            } catch (e) {}
            try {
                if (routeLineSource) map.sources.remove(routeLineSource);
            } catch (e) {}

            // Sort bins by predicted fullness or current fill level
            const sortedBins = bins.sort((a, b) => {
                // Log sorting logic
                console.log('Sorting bins based on DaysToFull and FillLevel');
                if (a.daysToFull !== b.daysToFull) {
                    return a.daysToFull - b.daysToFull; // Prioritize bins predicted to be full soon
                }
                return b.fillLevel - a.fillLevel; // Prioritize bins that are fuller
            });

            const validBins = sortedBins.filter(bin => bin.latitude !== 0 && bin.longitude !== 0);

            // Log valid bins for debugging
            console.log('Valid bins for routing:', validBins);

            if (validBins.length < 2) {
                alert("No valid bins with proper coordinates found for routing.");
                return;
            }

            const waypoints = validBins.map(bin => `${bin.latitude},${bin.longitude}`);

            const routeUrl = `https://atlas.microsoft.com/route/directions/json?api-version=1.0&subscription-key=${subscriptionKey}&query=${waypoints.join(':')}`;
            const response = await fetch(routeUrl);
            const data = await response.json();

            // Log the route response
            console.log('Route response:', data);

            if (!data.routes || data.routes.length === 0) {
                alert("No route found.");
                return;
            }

            const routePoints = data.routes[0].legs.flatMap(leg => leg.points.map(pt => [pt.longitude, pt.latitude]));

            routeLineSource = new atlas.source.DataSource();
            map.sources.add(routeLineSource);

            const routeLine = new atlas.data.LineString(routePoints);
            routeLineSource.add(new atlas.data.Feature(routeLine));

            routeLineLayer = new atlas.layer.LineLayer(routeLineSource, null, { strokeColor: '#00BFFF', strokeWidth: 5 });
            map.layers.add(routeLineLayer);

            const lons = routePoints.map(pt => pt[0]);
            const lats = routePoints.map(pt => pt[1]);
            map.setCamera({
                bounds: atlas.data.BoundingBox.fromPositions([
                    [Math.min(...lons), Math.min(...lats)],
                    [Math.max(...lons), Math.max(...lats)]
                ]),
                padding: 60
            });
        };
    });
</script>

