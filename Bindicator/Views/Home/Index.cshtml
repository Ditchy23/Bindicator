@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Bindicator prototype</h1>
    <h2>Smart bins. Smarter cities</h2>
</div>
<h2>Prototype features:</h2>
    <ul>
    <li>Real-time data monitoring.</li>
    <li>Integration with HiveMQ MQTT and SignalR for asynchronous notifications.</li>
    <li>Weight and density measurement.</li>
    <li>Temperature and humidity tracking.</li>
    <li>Bin location and dynamic route plotting via Azure Maps Atlas API.</li>
    <li>Hazardous condition warnings.</li>
    <li>Dashboard for bin data at a glance.</li>
    <li>Trends for all bin data.</li>
</ul>
<div class="row">
    <div class="col-md-4">
        <div class="card mb-4 shadow-sm">
            <div class="card-header">
                <h3 class="my-0 font-weight-normal">Dashboard</h3>
            </div>
            <div class="card-body">
                <p class="card-text">View the status of all bins.</p>
                <p class="card-text">Real-time data updates from live sensors.</p>
                <a href="@Url.Action("Index", "Dashboard")" class="btn btn-outline-primary">Dashboard</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mb-4 shadow-sm">
            <div class="card-header">
                <h3 class="my-0 font-weight-normal">Map</h3>
            </div>
            <div class="card-body">
                <p class="card-text">View bin locations.</p>
                <p class="card-text">Generate collection routes.</p>
                <a href="@Url.Action("Map", "Dashboard")" class="btn btn-outline-primary">Map</a>
            </div>
        </div>
    </div>
</div>