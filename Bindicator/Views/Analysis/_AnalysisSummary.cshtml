@model List<Bindicator.ViewModels.BinAnalysisResult>

<h2 class="mt-4">📈 Analysis Summary</h2>
<ul class="list-group">
    @foreach (var bin in Model)
    {
        <li class="list-group-item">
                <h3>Bin #@bin.BinId</h3>
            <div class="mt-2">
                @if (bin.Recommendation.Contains("⚠️"))
                {
                    <div class="alert alert-danger py-2 px-3 mb-2" role="alert">
                        @bin.Recommendation
                    </div>
                }
                else if (bin.Recommendation.Contains("🟢"))
                {
                    <div class="alert alert-success py-2 px-3 mb-2" role="alert">
                        @bin.Recommendation
                    </div>
                }
                else
                {
                    <div class="alert alert-info py-2 px-3 mb-2" role="alert">
                        @bin.Recommendation
                    </div>
                }
            </div>
        </li>
    }
</ul>